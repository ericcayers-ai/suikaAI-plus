#version 460
#extension GL_EXT_ray_tracing : require

// Ray generation — owns ALL shading and light transport for the RT game view.
//
// Structure: an ITERATIVE segment loop instead of recursive tracing from the
// closest-hit shader. The closest-hit shader only DESCRIBES the surface it found
// (position/normal/albedo/roughness/material class, via the HitInfo payload);
// this shader then decides what to do — shade an opaque hit, or pass through the
// jar's thin glass and keep going. Portability is the reason: several RT GPUs
// (notably AMD) report maxRayRecursionDepth == 1, so any design that traces rays
// FROM the hit shader is non-portable. Here every traceRayEXT call originates in
// raygen, which is always depth 1.
//
// Also implements:
//  * Thin-lens depth of field — the camera focuses on the jar; the tan wall
//    behind it lands well past the focal plane and melts into bokeh.
//  * Soft shadows (jittered area-light samples, denoised by denoise.comp).
//  * Per-frame exponential temporal accumulation (cheap TAA) to converge the
//    DoF + shadow noise while staying responsive to falling fruit.

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba32f) uniform image2D outputImage;

layout(binding = 2, set = 0) uniform CameraUBO {
    vec4  position;     // xyz = world position
    vec4  forward;      // xyz = normalized view direction
    vec4  right;        // xyz = normalized right vector
    vec4  up;           // xyz = normalized up vector
    float tanHalfFov;   // vertical half-fov tangent
    float time;         // seconds — jitters shadow/DoF sampling per frame
    float aperture;     // lens radius in world units (0 = pinhole, no bokeh)
    float focusDist;    // distance to the focal plane (the jar)
    float blend;        // temporal EMA weight for THIS frame (1.0 = no history)
    float aspect;       // width / height
    float pad0, pad1;
} cam;

// Matches the struct written by closesthit.rchit exactly (member-for-member).
struct HitInfo {
    vec4 posT;        // xyz = world hit position, w = hit distance (miss: w < 0)
    vec4 normalRough; // xyz = shading normal, w = roughness 0..1
    vec4 albedoMat;   // rgb = linear albedo, w = material class (see MAT_*)
};

const int MAT_FRUIT = 0;
const int MAT_WOOD  = 1;
const int MAT_WALL  = 2;
const int MAT_GLASS = 3;
const int MAT_METAL = 4;   // the movable drop chute

// Cull masks: glass is excluded from shadow rays (mask 0x01) so the jar doesn't
// cast a hard dark shadow over its own contents — physically light refracts
// through; skipping the glass on shadow rays is the standard cheap stand-in.
const uint MASK_SOLID = 0x01u;
const uint MASK_GLASS = 0x02u;

layout(location = 0) rayPayloadEXT HitInfo hit;
layout(location = 1) rayPayloadEXT float shadowVisibility;

// ---- per-pixel-per-frame hash (Monte-Carlo sample jitter) ----
vec2 hash2(vec2 p, float seed) {
    float a = fract(sin(dot(p, vec2(12.9898, 78.233)) + seed * 37.719) * 43758.5453);
    float b = fract(sin(dot(p, vec2(39.346, 11.135)) + seed * 71.221) * 12765.2341);
    return vec2(a, b);
}

// ---- environment: image-based lighting from a real studio HDRI ----
// Equirectangular Poly Haven "Pav Studio 03" (warm photo studio, matching the
// reference scene). What rays see when they escape the scene — and also what
// the glass jar and metal chute reflect, and where the ambient fill for every
// opaque surface comes from. Linear radiance straight from the file; EXPOSURE
// scales it into the same range the key light works in.
layout(binding = 7, set = 0) uniform sampler2D envMap;
const float ENV_EXPOSURE = 1.55;

vec3 envColor(vec3 d) {
    // Equirect mapping: u wraps around Y (atan), v = polar angle. The HDRI is
    // stored top row first (-Y orientation), matching v=0 at the zenith.
    vec2 uv = vec2(atan(d.z, d.x) * 0.15915494309 + 0.5,
                   acos(clamp(d.y, -1.0, 1.0)) * 0.31830988618);
    return textureLod(envMap, uv, 0.0).rgb * ENV_EXPOSURE;
}

// Key light: one big warm softbox up-right-front. Direction TOWARD the light.
const vec3  LIGHT_DIR   = normalize(vec3(0.35, 0.90, 0.55));
const vec3  LIGHT_COLOR = vec3(1.00, 0.97, 0.90);
const float LIGHT_INTENSITY = 2.35;
const float LIGHT_RADIUS = 0.16;      // disk jitter -> penumbra width
const float FILL = 0.30;              // ambient/fill fraction (a touch of contrast for the cinematic grade)

// Where resting fruit ends the game (PhysicsConfig.DEADLINE_Y = CONTAINER_HEIGHT - 1.5).
// Drawn as a faint warm line traced onto the glass so the player can see the limit.
const float DEADLINE_Y = 13.5;

float fresnelSchlick(float cosTheta) {
    float f0 = 0.04;
    return f0 + (1.0 - f0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// One soft-shadow visibility sample toward the jittered key light.
float traceShadow(vec3 origin, vec3 lightDir) {
    shadowVisibility = 0.0;
    traceRayEXT(topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
            MASK_SOLID, 0, 0, 1,
            origin, 0.001, lightDir, 1000.0, 1);
    return shadowVisibility;
}

vec3 shadeOpaque(vec3 P, vec3 N, vec3 rd, vec3 albedo, float rough, int mat, vec2 seed) {
    // Jitter the light direction on a disk for a soft penumbra.
    vec3 arb = abs(LIGHT_DIR.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 lt = normalize(cross(arb, LIGHT_DIR));
    vec3 lb = cross(LIGHT_DIR, lt);
    float r = sqrt(seed.x) * LIGHT_RADIUS;
    float th = seed.y * 6.28318530718;
    vec3 L = normalize(LIGHT_DIR + r * cos(th) * lt + r * sin(th) * lb);

    float ndotl = max(dot(N, L), 0.0);
    float vis = ndotl > 0.0 ? traceShadow(P + N * 0.01, L) : 0.0;

    // Fill/ambient from the environment in the normal direction — keeps shadowed
    // areas alive (a brightly lit studio has strong bounce fill, not black shadows).
    vec3 ambient = albedo * envColor(N) * FILL;
    vec3 diffuse = albedo * LIGHT_COLOR * (LIGHT_INTENSITY * ndotl * vis);

    // Blinn-Phong gloss driven by the (textured) roughness.
    vec3 V = -rd;
    vec3 H = normalize(L + V);
    float shininess = mix(110.0, 10.0, clamp(rough, 0.0, 1.0));
    float specStrength = mix(0.55, 0.06, clamp(rough, 0.0, 1.0));
    vec3 spec = LIGHT_COLOR * (pow(max(dot(N, H), 0.0), shininess) * specStrength * vis);

    vec3 c = ambient + diffuse + spec;

    // Grazing-angle rim light — a cheap, universal "definition" pass: it traces the
    // silhouette of every opaque object a little brighter so edges read crisply
    // against the backdrop instead of dissolving into flat shading.
    float rim = pow(1.0 - max(dot(N, V), 0.0), 4.0);
    c += albedo * rim * 0.10 * LIGHT_COLOR;

    if (mat == MAT_WALL) {
        // "Professionally lit backdrop": a broad, subtle softbox hotspot high on
        // the wall, falling off smoothly — the photography-studio look, not a
        // harsh spotlight. Positions are world-space (wall spans x, y up).
        float d2 = dot(P.xy - vec2(0.0, 14.0), P.xy - vec2(0.0, 14.0));
        c *= 1.0 + 0.30 * exp(-d2 / 260.0);
    }
    return c;
}

void main() {
    vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    // y is FLIPPED: launch row 0 is the TOP of the presented image, so the top of
    // the window must map to +up (the old version skipped this and rendered the
    // world upside down — unnoticeable with its symmetric orbit showcase).
    vec2 d = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);

    vec3 pixelDir = normalize(cam.forward.xyz
            + d.x * cam.tanHalfFov * cam.aspect * cam.right.xyz
            + d.y * cam.tanHalfFov * cam.up.xyz);

    // ---- thin-lens depth of field ----
    // Focal point stays fixed; the ray origin wanders over the lens aperture.
    // Surfaces near focusDist converge sharp; the wall far behind blurs to bokeh.
    vec2 lensSeed = hash2(pixelCenter, cam.time);
    float lr = sqrt(lensSeed.x) * cam.aperture;
    float la = lensSeed.y * 6.28318530718;
    vec3 lensOffset = lr * (cos(la) * cam.right.xyz + sin(la) * cam.up.xyz);
    vec3 focal = cam.position.xyz + pixelDir * cam.focusDist;
    vec3 ro = cam.position.xyz + lensOffset;
    vec3 rd = normalize(focal - ro);

    vec2 shadeSeed = hash2(pixelCenter + 17.31, cam.time);

    vec3 color = vec3(0.0);
    vec3 tint = vec3(1.0);

    // Segment loop: pass through up to 3 glass surfaces (near wall, far wall,
    // grazing re-entry) before giving up and taking the environment.
    const int MAX_SEGMENTS = 5;
    for (int seg = 0; seg < MAX_SEGMENTS; seg++) {
        hit.posT = vec4(0.0, 0.0, 0.0, -1.0);
        traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, ro, 0.001, rd, 1000.0, 0);

        if (hit.posT.w < 0.0) {              // escaped the scene
            color += tint * envColor(rd);
            break;
        }

        int mat = int(hit.albedoMat.w + 0.5);
        vec3 P = hit.posT.xyz;
        vec3 N = hit.normalRough.xyz;

        if (mat == MAT_METAL) {
            // The drop chute: brushed steel, not a chrome mirror — roughness (now
            // 0.55 by default, see RtScene) lowers overall reflectivity and broadens
            // the specular streak into a softer highlight instead of a razor mirror.
            vec3 R = reflect(rd, N);
            float ndv = clamp(dot(N, -rd), 0.0, 1.0);
            float rough = clamp(hit.normalRough.w, 0.0, 1.0);
            float fres = mix(0.72, 0.30, rough) + mix(0.28, 0.10, rough) * pow(1.0 - ndv, 3.0);
            vec3 base = hit.albedoMat.rgb;
            vec3 c = base * envColor(R) * fres;
            vec3 H = normalize(LIGHT_DIR - rd);
            float shininess = mix(260.0, 55.0, rough);
            c += base * LIGHT_COLOR * pow(max(dot(N, H), 0.0), shininess) * mix(2.2, 1.05, rough);
            c += base * envColor(N) * mix(0.08, 0.24, rough);   // rougher = more diffuse fill
            color += tint * c;
            break;
        }

        if (mat == MAT_GLASS) {
            // Thin glass: parallel surfaces cancel refraction bend, so the ray
            // continues straight with a slight tint; the reflective side of the
            // Fresnel split is approximated with an environment lookup plus the
            // key light's specular ping — cheap, but reads unmistakably as glass.
            //
            // Real jar, not showroom gloss: grazing angles ABSORB instead of glow.
            // A photographed jar's silhouette goes dark — light path length through
            // the glass diverges at the profile edge — so the rim term multiplies
            // the through-tint down hard, with only a whisper of cool sheen added
            // back on top. Reflection strength is kept moderate for the same reason.
            float cosI = clamp(dot(-rd, N), 0.0, 1.0);
            float fres = fresnelSchlick(cosI);
            float rim = pow(1.0 - cosI, 5.0);
            vec3 R = reflect(rd, N);
            color += tint * fres * envColor(R) * 0.70;
            color += tint * rim * rim * vec3(0.35, 0.42, 0.50) * 0.18;
            vec3 H = normalize(LIGHT_DIR - rd);
            color += tint * LIGHT_COLOR * pow(max(dot(N, H), 0.0), 260.0) * 1.2;

            // Faint deadline line on the jar wall: resting fruit above this height
            // ends the game. Band on the side glass only (not the base disc).
            // Etched into the glass, not painted on top: the band both EMITS a warm
            // tone and DARKENS transmission, so it stays legible against the bright
            // studio wall behind the jar instead of washing out.
            float band = 1.0 - smoothstep(0.0, 0.14, abs(P.y - DEADLINE_Y));
            if (band > 0.0 && length(P.xz) > 3.0) {
                color += tint * vec3(1.0, 0.35, 0.22) * band * 0.5;
                tint *= 1.0 - band * 0.30;
            }

            tint *= vec3(0.90, 0.945, 0.93) * (1.0 - fres * 0.55 - rim * 0.55);
            ro = P + rd * 0.004;             // continue through the pane
            continue;
        }

        color += tint * shadeOpaque(P, N, rd, hit.albedoMat.rgb, hit.normalRough.w, mat, shadeSeed);
        break;
    }

    // Cinematic finish: ACES filmic tonemap (real highlight shoulder + gentle toe,
    // richer mids than the old soft-Reinhard) plus a subtle lens vignette so the
    // frame's corners fall off like glass optics, keeping the eye on the jar.
    color = max(color * 0.92, vec3(0.0));
    color = clamp((color * (2.51 * color + 0.03)) / (color * (2.43 * color + 0.59) + 0.14), 0.0, 1.0);
    float vig = 1.0 - 0.26 * pow(clamp(length(d * vec2(cam.aspect, 1.0)) / 1.55, 0.0, 1.0), 2.3);
    color *= vig;
    color = pow(color, vec3(1.0 / 2.2));

    // Temporal EMA against last frame's value already in the output image.
    ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    vec3 history = imageLoad(outputImage, pix).rgb;
    vec3 blended = mix(history, color, clamp(cam.blend, 0.0, 1.0));
    imageStore(outputImage, pix, vec4(blended, 1.0));
}
