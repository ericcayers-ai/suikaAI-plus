# EditorConfig — consistent formatting across editors. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,kt,kts}]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # trailing spaces are meaningful (hard line breaks)

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
